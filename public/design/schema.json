        },
        {
          "name": "idx_review_cafe",
          "unique": false,
          "cols": "cafe_id, created_at"
        }
      ],
      "checks": [
        {
          "name": "ck_review_rating",
          "expression": "rating BETWEEN 1 AND 5"
        }
      ]
    }
  ]
}
