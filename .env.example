# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올리지 않습니다)
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=studycafe

# developers.kakao.com > 내 애플리케이션 > 앱 키
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# ---- 인터넷 DB(Aiven)와 배포(Vercel). 설명: docs/HOSTED_DB.md ----
# 인터넷 DB 용 값은 .env.hosted 에 따로 두고 ENV_FILE=.env.hosted 로 고른다 (이 파일들은 git 에 올라가지 않는다)
# DATABASE_URL=mysql://avnadmin:비밀번호@호스트:포트/defaultdb?ssl-mode=REQUIRED
# DB_SSL_CA_FILE=data/aiven-ca.pem
# DB_SKIP_CREATE=true
# 로그인 토큰 서명용 임의의 긴 문자열 (Vercel 에서는 필수)
# AUTH_SECRET=
# 소셜 로그인 (선택)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://사이트주소
